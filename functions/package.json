{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test \"test/*.test.js\"",
    "test:emulator": "node --test --test-concurrency=1 \"test/emulator/*.test.js\"",
    "test:emulator:exec": "npm run build && firebase emulators:exec --project demo-fitnesbuster --config ../firebase.json --only auth,firestore,functions \"npm run test:emulator\"",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^10.7.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "qs": "^6.16.0"
  },
  "private": true
}
