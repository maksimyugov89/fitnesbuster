rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function hasCurrentLegalConsent(uid) {
      return exists(
        /databases/$(database)/documents/users/$(uid)/legal_consents/terms-2026-07-07-privacy-2026-07-17
      );
    }

    function validCurrentLegalConsent(consentId) {
      return consentId == 'terms-2026-07-07-privacy-2026-07-17' &&
        request.resource.data.keys().hasOnly([
          'termsVersion',
          'privacyPolicyVersion',
          'acceptedAt',
          'source',
          'locale',
        ]) &&
        request.resource.data.termsVersion == '2026-07-07' &&
        request.resource.data.privacyPolicyVersion == '2026-07-17' &&
        request.resource.data.acceptedAt == request.time &&
        request.resource.data.source in [
          'email_registration',
          'google_registration',
          'google_login',
          'login',
        ] &&
        request.resource.data.locale is string;
    }

    // ── Users ──────────────────────────────────────────────────────────────────
    // Full profile documents contain email, fcmToken and medical restrictions —
    // readable only by the owner. Cross-user lookups (search, friends, feed) use
    // denormalized name/username fields already stored on friends/feed/search
    // results, never a direct read of another user's document.
    match /users/{uid} {
      allow read: if signedInAs(uid);
      allow create: if signedInAs(uid) && hasCurrentLegalConsent(uid);
      allow update, delete: if signedInAs(uid);
    }

    // ── Legal consent records ─────────────────────────────────────────────────
    // Client may create exactly one current-version consent record for itself.
    // It uses server time and cannot be edited afterwards. A delete is allowed
    // only while rolling back a failed registration before the profile doc exists.
    match /users/{uid}/legal_consents/{consentId} {
      allow read: if signedInAs(uid);
      allow create: if signedInAs(uid) &&
        validCurrentLegalConsent(consentId);
      allow delete: if signedInAs(uid) &&
        !exists(/databases/$(database)/documents/users/$(uid));
    }

    // ── Friend requests ────────────────────────────────────────────────────────
    // All mutations (send/accept/decline) go through Cloud Functions, which
    // validate duplicates, ownership and status transitions with Admin SDK
    // (bypasses these rules). Direct client writes would skip that validation.
    match /friend_requests/{reqId} {
      allow read: if request.auth != null &&
        (resource.data.fromUid == request.auth.uid ||
         resource.data.toUid   == request.auth.uid);
      // Write only via Cloud Functions (Admin SDK bypasses rules)
    }

    // ── Friends lists (bidirectional sub-collections) ─────────────────────────
    match /friends/{uid}/list/{friendUid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Write only via Cloud Functions (Admin SDK bypasses rules)
    }

    // ── Activity events (written by Cloud Functions only) ─────────────────────
    // Clients publish via the validated publishActivity callable; direct writes
    // stay locked down so unvalidated events cannot be fanned out to friends.
    match /activity_events/{uid}/items/{eventId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Write only via Cloud Functions (Admin SDK bypasses rules)
    }

    // ── Feed (written by Cloud Functions only) ─────────────────────────────────
    match /feed/{uid}/events/{eventId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Write only via Cloud Functions (Admin SDK)
    }

    // ── Challenges ─────────────────────────────────────────────────────────────
    // createChallenge/joinChallenge (Cloud Functions) enforce duration/target
    // limits and participant integrity — direct client writes would bypass them.
    match /challenges/{challengeId} {
      allow read: if request.auth != null;
      // Write only via Cloud Functions (Admin SDK bypasses rules)
    }

    match /challenge_progress/{challengeId}/participants/{uid} {
      allow read: if request.auth != null;
      // Write only via Cloud Functions (Admin SDK) —
      // updateChallengeProgress enforces monotonic, clamped progress
    }

    // ── Notifications ──────────────────────────────────────────────────────────
    // Not currently read or written by the Flutter client at all — reserved
    // for a future in-app notifications inbox.
    match /notifications/{uid}/items/{notifId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Write only via Cloud Functions (Admin SDK bypasses rules)
    }
  }
}
